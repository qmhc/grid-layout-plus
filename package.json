{
  "name": "grid-layout-plus",
  "version": "1.1.1",
  "type": "module",
  "packageManager": "pnpm@9.14.2",
  "license": "MIT",
  "author": "qmhc",
  "scripts": {
    "benchmark": "node --expose-gc --import tsx scripts/benchmark.ts",
    "build": "node --import tsx scripts/build.ts",
    "build:docs": "pnpm -C docs build",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s --commit-path .",
    "check:docs": "node --import tsx docs/.vitepress/check-docs.ts",
    "dev": "pnpm -C dev-server serve",
    "dev:docs": "pnpm -C docs serve",
    "lint": "eslint --cache --config eslint.config.ts \"**/*.{js,cjs,mjs,ts,tsx,vue}\"",
    "lint:style": "stylelint --config stylelint.config.ts --cache \"**/*.{vue,scss}\"",
    "precommit": "lint-staged -c ./.husky/.lintstagedrc -q",
    "prepare": "husky",
    "prepublishOnly": "pinst --disable",
    "prettier": "prettier --config prettier.config.ts --write \"{src,dev-server,docs}/**/*.{ts,js,json,css,pcss,scss,vue,html,md}\"",
    "prettier:scripts": "prettier --config prettier.config.ts --write \"scripts/**/*.{ts,js,json}\"",
    "postpublish": "pinst --enable",
    "publish:ci": "tsx scripts/publish.ts",
    "release": "tsx scripts/release.ts",
    "test": "vitest run",
    "test:cover": "vitest run --coverage",
    "test:dev": "vitest dev",
    "test:e2e": "playwright test",
    "test:release-markers": "node --import tsx scripts/check-release-tests.ts",
    "test:types": "tsc -p tests/types/tsconfig.json"
  },
  "main": "lib/index.cjs",
  "module": "es/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./es/index.mjs",
      "require": "./lib/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./es/core.mjs",
      "require": "./lib/core.cjs"
    },
    "./es": {
      "types": "./dist/index.d.ts",
      "import": "./es/index.mjs"
    },
    "./lib": {
      "types": "./dist/index.d.ts",
      "require": "./lib/index.cjs"
    },
    "./es/*.mjs": {
      "types": "./dist/*.d.ts",
      "import": "./es/*.mjs"
    },
    "./es/*": {
      "types": [
        "./dist/*.d.ts",
        "./dist/*/index.d.ts"
      ],
      "import": "./es/*.mjs"
    },
    "./lib/*.cjs": {
      "types": "./dist/*.d.ts",
      "require": "./lib/*.cjs"
    },
    "./lib/*": {
      "types": [
        "./dist/*.d.ts",
        "./dist/*/index.d.ts"
      ],
      "require": "./lib/*.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "es",
    "lib",
    "src",
    "CHANGELOG.md",
    "types.d.ts"
  ],
  "keywords": [
    "flex",
    "components",
    "vue",
    "vexip",
    "plugin",
    "toolkit",
    "vite",
    "layout",
    "grid-layout",
    "vue-grid-layout"
  ],
  "dependencies": {
    "@vexip-ui/hooks": "^2.9.4",
    "@vexip-ui/utils": "catalog:",
    "interactjs": "^1.10.27"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.4",
    "@interactjs/types": "^1.10.27",
    "@playwright/test": "^1.62.1",
    "@types/minimist": "^1.2.5",
    "@types/node": "^25.5.0",
    "@types/prompts": "^2.4.9",
    "@types/semver": "^7.7.1",
    "@vexip-ui/commitlint-config": "^0.5.0",
    "@vexip-ui/eslint-config": "^1.3.0",
    "@vexip-ui/prettier-config": "^1.1.0",
    "@vexip-ui/stylelint-config": "^1.1.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.4",
    "changelogithub": "14.0.0",
    "conventional-changelog": "^7.2.0",
    "conventional-changelog-angular": "8.3.1",
    "eslint": "^9.39.4",
    "execa": "^9.6.1",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "kolorist": "^1.8.0",
    "lint-staged": "^16.4.0",
    "minimist": "^1.2.8",
    "pinst": "^3.0.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "prompts": "^2.4.2",
    "sass": "^1.102.0",
    "semver": "^7.8.5",
    "stylelint": "^16.26.1",
    "stylelint-prettier": "^5.0.3",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vite": "^8.2.0",
    "vite-plugin-css-injected-by-js": "^4.0.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.10",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowAny": [
        "@csstools/*"
      ],
      "ignoreMissing": [
        "@algolia/client-search",
        "vue"
      ]
    },
    "overrides": {
      "editorconfig>minimatch": "9.0.9",
      "js-beautify>glob": "10.5.0",
      "vite@5.4.21>esbuild": "0.25.0",
      "vite-plugin-dts>@microsoft/api-extractor": "7.57.7"
    }
  }
}
