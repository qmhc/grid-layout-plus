{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "allowJs": false,
    "strict": true,
    "jsx": "preserve",
    "importHelpers": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": false,
    "paths": {
      "grid-layout-plus": ["../src"]
    },
    "types": ["node", "vite/client"],
    "lib": ["esnext", "dom"]
  },
  "include": ["../src/global.d.ts", "**/*", ".vitepress/**/*"],
  "exclude": ["node_modules"]
}
